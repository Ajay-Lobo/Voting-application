PORT=5000
MONGO_URI=mongodb://localhost:27017/voting
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins (default http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
# Required to create an admin account (admin signup is disabled when unset)
ADMIN_SIGNUP_KEY=change-me
